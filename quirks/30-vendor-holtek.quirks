# Do not edit this file, it will be overwritten on update

# The keyboard interface of this gaming mouse (sold as Rapture VENOM V2,
# among others) sends macro and media keys. Its consumer control array
# covers AC Pan, which the kernel maps to REL_HWHEEL, so the device gets
# the pointer capability and shows up as a second mouse. It has no wheel.
[Holtek 04D9:A09F Gaming Mouse Keyboard]
MatchUdevType=keyboard
MatchBus=usb
MatchVendor=0x04D9
MatchProduct=0xA09F
AttrEventCode=-REL_HWHEEL;-REL_HWHEEL_HI_RES
